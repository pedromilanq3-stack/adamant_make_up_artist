# Identificador visto na URL do Ads Manager (sem o prefixo "act=").
META_AD_ACCOUNT_ID=934861699094739

# Nunca envie este segredo ao GPT ou o salve no Git.
META_ACCESS_TOKEN=cole_aqui_um_token_de_system_user

# Defina explicitamente uma versão ainda suportada pela Meta.
META_API_VERSION=vXX.X

# Segredo aleatório usado para assinar confirmações de alterações.
APP_CONFIRMATION_SECRET=troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres

# Chave enviada pela Action do GPT no cabeçalho X-API-Key.
GATEWAY_API_KEY=troque-por-outra-string-aleatoria-com-32-ou-mais-caracteres
